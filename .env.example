# Copy to .env.local and fill in your Supabase credentials
# Then update app.json → extra → supabaseUrl and supabaseAnonKey

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Canonical base URL for share links (bill /share/{code} + participant /p/{token}).
# Falls through to app.json extra.shareBaseUrl then a hardcoded production default.
# Override locally when developing against a tunnel URL (ngrok, Cloudflared) so
# share links resolve to your machine. Flip this when a custom domain ships.
EXPO_PUBLIC_WEB_BASE_URL=https://go-check.vercel.app

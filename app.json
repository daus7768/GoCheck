{
  "expo": {
    "name": "GoCheck",
    "slug": "gocheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gocheck.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "GoCheck uses Face ID to unlock and protect your account."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.gocheck.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoCheck uses your photos to add a group photo to bills.",
          "cameraPermission": "GoCheck uses your camera to take a group photo."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "gocheck",
    "extra": {
      "supabaseUrl": "https://bccarnwtdqamedtlzdht.supabase.co",
      "supabaseAnonKey": "sb_publishable_VzCR4JOptTjishRkubio-A_PrQQ-UTr",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
